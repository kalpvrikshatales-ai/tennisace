# Backend API URL - set to live Render URL in production
NEXT_PUBLIC_API_URL=http://localhost:8000

# Web Push VAPID public key (used by browser for notifications)
NEXT_PUBLIC_VAPID_KEY=your_public_vapid_key

# Supabase project — anon key is public by design (protected by RLS), but keep it
# in env vars rather than hardcoded so it can be rotated without a code change.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
